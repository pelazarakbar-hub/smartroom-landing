# Salin file ini menjadi .env lalu isi API key kamu (JANGAN di-commit)
ANTHROPIC_API_KEY=sk-ant-isi-di-sini
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000
# Batas panggilan Claude per hari (melindungi biaya)
MAX_DAILY_CALLS=300
# Opsional (produksi): domain frontend yang boleh mengakses API, pisahkan dengan koma
# ALLOWED_ORIGIN=https://username.github.io
